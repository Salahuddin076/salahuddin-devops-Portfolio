# Documentation-safe values only: replace with real ones in a private tfvars.
region              = "eu-west-1"
owner               = "web-platform"
name_prefix         = "static-demo"
domain_names        = ["example.com", "www.example.com"]
hosted_zone_id      = "Z0123456789EXAMPLE0AB"
price_class         = "PriceClass_100"
github_repository   = "example-org/example-site"
github_environments = ["production"]

