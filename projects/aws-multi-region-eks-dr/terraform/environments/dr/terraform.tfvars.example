# Copy to terraform.tfvars and adjust. Placeholder values only.
region             = "us-west-2"
vpc_cidr           = "10.20.0.0/16"
nat_gateway_per_az = false
kubernetes_version = "1.34"

endpoint_public_access_cidrs = ["203.0.113.0/24"]
cluster_admin_principal_arns = ["arn:aws:iam::123456789012:role/platform-admin"]

node_scaling    = { min = 2, desired = 2, max = 12 }
app_bucket_name = "example-dr-app-data-us-west-2"
