{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dr-app values",
  "type": "object",
  "required": ["region", "regionRole", "image", "config", "api", "workers", "ingress", "networkPolicy"],
  "properties": {
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]$"
    },
    "regionRole": {
      "type": "string",
      "enum": ["primary", "dr"]
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1, "not": { "const": "latest" } },
        "pullPolicy": { "type": "string", "enum": ["IfNotPresent", "Always"] }
      }
    },
    "config": {
      "type": "object",
      "required": ["dbHost", "dbSecretId", "cacheHost"],
      "properties": {
        "dbHost": { "type": "string", "minLength": 1 },
        "dbReaderHost": { "type": "string" },
        "dbSecretId": { "type": "string", "minLength": 1 },
        "cacheHost": { "type": "string", "minLength": 1 },
        "bucketName": { "type": "string" },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] }
      }
    },
    "api": {
      "type": "object",
      "required": ["containerPort", "resources", "autoscaling", "pdb", "preStopSleepSeconds", "terminationGracePeriodSeconds"],
      "properties": {
        "containerPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"]
        },
        "autoscaling": {
          "type": "object",
          "required": ["enabled", "minReplicas", "maxReplicas"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 10, "maximum": 95 }
          }
        },
        "pdb": {
          "type": "object",
          "required": ["minAvailable"],
          "properties": {
            "minAvailable": { "type": "integer", "minimum": 1 }
          }
        },
        "preStopSleepSeconds": { "type": "integer", "minimum": 1, "maximum": 120 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "workers": {
      "type": "object",
      "required": ["enabled", "replicas", "healthPort", "resources", "terminationGracePeriodSeconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0 },
        "healthPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "resources": { "type": "object", "required": ["requests", "limits"] },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "topologySpread": {
      "type": "object",
      "properties": {
        "whenUnsatisfiable": { "type": "string", "enum": ["DoNotSchedule", "ScheduleAnyway"] }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "minLength": 1 },
        "regionalHost": { "type": "string", "minLength": 1 },
        "certificateArn": { "type": "string", "pattern": "^arn:aws[a-z-]*:acm:" },
        "scheme": { "type": "string", "enum": ["internet-facing", "internal"] },
        "healthcheckPath": { "type": "string", "pattern": "^/" },
        "loadBalancerName": { "type": "string", "maxLength": 32 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "albSourceCidrs", "dataSubnetCidrs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "albSourceCidrs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "dataSubnetCidrs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "awsApiEgress": { "type": "boolean" }
      }
    }
  }
}
