{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "n8n-platform values",
  "type": "object",
  "required": ["image", "publicUrl", "serviceAccount", "secrets", "database", "redis", "queue", "executions", "main", "webhook", "worker", "keda"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "A pinned n8n release, never latest/next."},
        "pullPolicy": {"enum": ["IfNotPresent", "Always"]}
      }
    },
    "publicUrl": {"type": "string", "pattern": "^https://.+/$"},
    "serviceAccount": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "secrets": {
      "type": "object",
      "required": ["mountPath", "encryptionKey", "db", "redisAuth"],
      "properties": {
        "mountPath": {"type": "string", "pattern": "^/"}
      }
    },
    "database": {
      "type": "object",
      "required": ["host", "port", "name"],
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "ssl": {"const": true, "description": "RDS enforces TLS (rds.force_ssl)."}
      }
    },
    "redis": {
      "type": "object",
      "required": ["host", "port", "tls"],
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "tls": {"const": true, "description": "ElastiCache runs with transit encryption required."}
      }
    },
    "queue": {
      "type": "object",
      "required": ["bullPrefix"],
      "properties": {
        "bullPrefix": {"type": "string", "pattern": "^[a-z0-9-]+$", "description": "No braces: cluster-mode hash tags would change the key KEDA must watch."}
      }
    },
    "executions": {
      "type": "object",
      "required": ["maxExecutionSeconds"],
      "properties": {
        "maxExecutionSeconds": {"type": "integer", "minimum": 30, "maximum": 86400},
        "prune": {"type": "boolean"},
        "pruneMaxAgeHours": {"type": "integer", "minimum": 1}
      }
    },
    "main": {
      "type": "object",
      "required": ["replicas"],
      "properties": {
        "replicas": {"const": 1, "description": "Single-main mode: more than one main runs every schedule twice."},
        "podDisruptionBudget": {
          "type": "object",
          "properties": {"maxUnavailable": {"type": "integer", "minimum": 0, "maximum": 1}}
        }
      }
    },
    "webhook": {
      "type": "object",
      "properties": {
        "autoscaling": {
          "type": "object",
          "properties": {
            "minReplicas": {"type": "integer", "minimum": 2},
            "maxReplicas": {"type": "integer", "minimum": 2}
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "required": ["concurrency"],
      "properties": {
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 100},
        "preStopSleepSeconds": {"type": "integer", "minimum": 0, "maximum": 30},
        "shutdownBufferSeconds": {"type": "integer", "minimum": 10}
      }
    },
    "keda": {
      "type": "object",
      "properties": {
        "minReplicaCount": {"type": "integer", "minimum": 0},
        "maxReplicaCount": {"type": "integer", "minimum": 1},
        "pollingInterval": {"type": "integer", "minimum": 5},
        "cooldownPeriod": {"type": "integer", "minimum": 60},
        "listLength": {"type": "integer", "minimum": 1},
        "activationListLength": {"type": "integer", "minimum": 0}
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "vpcCidr": {"type": "string", "pattern": "^[0-9.]+/[0-9]+$"},
        "dataSubnetCidrs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9.]+/[0-9]+$"}}
      }
    }
  }
}
