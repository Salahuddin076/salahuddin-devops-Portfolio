{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAccountPublicAccessBlockChanges",
      "Effect": "Deny",
      "Action": "s3:PutAccountPublicAccessBlock",
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/LandingZoneBreakGlass"
        }
      }
    }
  ]
}
