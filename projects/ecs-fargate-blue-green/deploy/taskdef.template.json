{
  "family": "${FAMILY}",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "${CPU}",
  "memory": "${MEMORY}",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "${CPU_ARCHITECTURE}"
  },
  "executionRoleArn": "${EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "${CONTAINER_NAME}",
      "image": "${IMAGE}",
      "essential": true,
      "user": "10001:10001",
      "readonlyRootFilesystem": true,
      "portMappings": [
        {
          "containerPort": "${CONTAINER_PORT}",
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "APP_ENV", "value": "${APP_ENV}" },
        { "name": "PORT", "value": "${CONTAINER_PORT}" },
        { "name": "IMAGE_TAG", "value": "${IMAGE_TAG}" }
      ],
      "secrets": [
        { "name": "DB_PASSWORD", "valueFrom": "${DB_SECRET_ARN}:password::" }
      ],
      "healthCheck": {
        "command": ["CMD", "python", "/app/healthcheck.py"],
        "interval": 15,
        "timeout": 3,
        "retries": 3,
        "startPeriod": 10
      },
      "linuxParameters": { "initProcessEnabled": true },
      "stopTimeout": 20,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "${LOG_GROUP}",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "${APP_ENV}",
          "mode": "non-blocking",
          "max-buffer-size": "4m"
        }
      }
    }
  ]
}
