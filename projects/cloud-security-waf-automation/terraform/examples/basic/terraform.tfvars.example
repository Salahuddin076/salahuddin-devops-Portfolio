# Documentation-safe values only: replace with real ones in a private tfvars.
region          = "us-east-1"
owner           = "security-engineering"
alb_arn         = "arn:aws:elasticloadbalancing:us-east-1:123456789012:loadbalancer/app/example-public-alb/0123456789abcdef"
allow_ip_cidrs  = ["192.0.2.0/28"]
block_ip_cidrs  = ["198.51.100.0/24", "203.0.113.128/25"]
sqli_mode       = "count"
rate_limit_mode = "count"
page_emails     = ["secops-oncall@example.com"]
ticket_emails   = ["secops-queue@example.com"]

