variable "azure_subscription_id" {
  description = "Azure subscription ID. Synthetic placeholder -- this example is never applied."
  type        = string
  default     = "00000000-0000-0000-0000-000000000000"
}

variable "azure_tenant_id" {
  description = "Azure AD tenant ID. Synthetic placeholder -- this example is never applied."
  type        = string
  default     = "11111111-1111-1111-1111-111111111111"
}

variable "gcp_project_id" {
  description = "GCP project ID. Synthetic placeholder -- this example is never applied."
  type        = string
  default     = "example-multi-cloud"
}
